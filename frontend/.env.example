# Leave this unset to use the Vite dev proxy (see vite.config.js), which
# forwards /api requests to http://localhost:8080 with no CORS involved.
# Set it only if you're pointing at a backend that isn't on localhost:8080,
# or when building for production (the backend then needs CORS enabled for
# your frontend's origin — see CORS_ALLOWED_ORIGINS in the backend's .env).
# VITE_API_BASE_URL=http://localhost:8080/api/v1
